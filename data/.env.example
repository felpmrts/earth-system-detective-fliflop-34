# ==============================================================================
# Configuração e Credenciais das 5 APIs — Earth System Trend Detective (data/)
# ==============================================================================
# INSTRUÇÕES:
# 1. Preencha suas credenciais no arquivo local `data/.env` (ignorado pelo Git).
# 2. Nunca coloque tokens ou senhas reais neste arquivo `.env.example`.
# 3. Os conectores em data/connectors/ e o servidor python3 -m data.api.server leem data/.env automaticamente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NASA POWER API v2 (Sem cadastro — 100% aberta | limite: 30 req/min)
# ------------------------------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/monthly/point

# ------------------------------------------------------------------------------
# 2. Open-Meteo Flood API / GloFAS (Sem cadastro para uso não-comercial)
# ------------------------------------------------------------------------------
OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com/v1/flood

# ------------------------------------------------------------------------------
# 3. NOAA CDO API v2 (EXIGE CADASTRO — token gratuito enviado por e-mail)
#    Onde cadastrar: https://www.ncdc.noaa.gov/cdo-web/token
# ------------------------------------------------------------------------------
NOAA_CDO_BASE_URL=https://www.ncei.noaa.gov/cdo-web/api/v2
NOAA_CDO_TOKEN=

# ------------------------------------------------------------------------------
# 4. NASA AppEEARS API / MODIS (EXIGE CADASTRO — NASA Earthdata Login)
#    Onde cadastrar: https://urs.earthdata.nasa.gov/users/new
#    Obs.: Catálogo (/api/product/*) é público; /api/login e /api/task exigem conta.
# ------------------------------------------------------------------------------
NASA_APPEEARS_BASE_URL=https://appeears.earthdatacloud.nasa.gov/api
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ------------------------------------------------------------------------------
# 5. NASA Giovanni / GES DISC (EXIGE CADASTRO — NASA Earthdata Login)
#    Onde cadastrar: https://urs.earthdata.nasa.gov/users/new
#    Importante: autorize o aplicativo "NASA GESDISC DATA ARCHIVE" no seu perfil
#    Earthdata e gere seu Bearer Token em "Generate Token" (ou baixe CSV direto
#    pelo portal Giovanni após login).
# ------------------------------------------------------------------------------
NASA_GIOVANNI_URL=https://giovanni.gsfc.nasa.gov/giovanni/
EARTHDATA_TOKEN=
# Servidor HTTP local/deploy
DATA_API_MAX_BODY_BYTES=1048576
# Use a origem exata do frontend em produção; "*" é conveniente apenas no desenvolvimento local.
DATA_API_CORS_ORIGIN=*
# Limite máximo de células adjacentes por região (ex.: 9 = 3x3, 25 = 5x5, 49 = 7x7)
MAX_CELLS_PER_REGION=25

# ------------------------------------------------------------------------------
# 6. Chatbot Co-Piloto Estatístico (LLM Gemini opcional + Function Calling)
#    Se GEMINI_API_KEY ficar vazio, o sistema opera em modo determinístico local
#    com as mesmas 6 ferramentas estatísticas em Python (< 15 ms, sem rede).
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_COPILOT_MODEL=gemini-2.5-flash
GEMINI_COPILOT_TIMEOUT=10.0
