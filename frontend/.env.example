# Modo de obtenção de dados de análise: "api" (backend Python) | "offline" (public/data/)
VITE_DATA_MODE=api

# URL base do backend Python (stats_engine.py) quando VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:8000

# Limite máximo de células conectadas por região (ex.: 9 = 3x3, 25 = 5x5, 49 = 7x7)
VITE_MAX_CELLS_PER_REGION=25
